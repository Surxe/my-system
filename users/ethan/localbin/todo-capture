#!/usr/bin/env bash
#
# todo-capture - quick, GUI-friendly capture into the shared todo store.
#
# Thin GUI front-end for `todo add`. It only prompts (kdialog / clipboard) and
# then delegates the actual append to the deployed `todo` command in ethan's
# ~/.local/bin — a reviewed COPY of bin/todo (deployed by this repo's
# users/install.sh deploy_todo_ethan), not dev-repo code, so ethan still never
# executes the dev-writable tree. All store logic (id scheme, .seq, locking,
# perms) now lives in exactly one place, bin/todo; this no longer duplicates it.
#
# Usage:
#   todo-capture <text…>      append text as a new todo
#   todo-capture --dialog     kdialog single-field prompt, then append
#   todo-capture --clipboard  append the current Wayland clipboard (wl-paste)
set -euo pipefail

notify() { kdialog --passivepopup "$1" "${2:-3}" 2>/dev/null || true; }
err()    { kdialog --error "$1" 2>/dev/null || printf 'todo-capture: %s\n' "$1" >&2; exit 1; }

# Requires the deployed `todo` (my-system users/install.sh, run as ethan). Fail
# clearly if it isn't on PATH yet rather than silently dropping the capture.
command -v todo >/dev/null 2>&1 || err "todo not found on PATH (deploy it: run my-system users/install.sh as ethan)"

capture() {   # $1 = text
    local text="$1" out id
    text="${text#"${text%%[![:space:]]*}"}"      # ltrim
    text="${text%"${text##*[![:space:]]}"}"      # rtrim
    [ -n "$text" ] || exit 0                      # empty -> silently do nothing
    # Delegate to the single source of truth. `todo add` prints "✓ todo <id> captured".
    out=$(todo add "$text") || err "todo add failed"
    id=$(printf '%s' "$out" | grep -oE 't-[0-9]+' | head -n1)
    notify "✓ captured ${id:-todo}"
    printf '%s\n' "${id:-$out}"
}

case "${1:-}" in
    --dialog)
        text=$(kdialog --title "New todo" --inputbox "Describe the todo:") || exit 0  # Cancel
        capture "$text" ;;
    --clipboard)
        command -v wl-paste >/dev/null 2>&1 || err "wl-paste not found (install wl-clipboard)"
        capture "$(wl-paste 2>/dev/null || true)" ;;
    "")
        err "usage: todo-capture <text…> | --dialog | --clipboard" ;;
    *)
        capture "$*" ;;
esac
