#!/usr/bin/env python3
"""Print the battery level of a Razer device via the OpenRazer daemon.

No sudo required (relies on the openrazer-daemon + plugdev udev rule).
Run with --help to see the presentation modes.
"""
import argparse
import sys

import openrazer.client


def get_battery():
    """Return (name, percent:int, charging:bool) for the first Razer
    device that reports a battery, or None if there isn't one."""
    dm = openrazer.client.DeviceManager()
    for d in dm.devices:
        try:
            if d.has("battery"):
                return d.name, round(d.battery_level), bool(d.is_charging)
        except Exception:
            continue
    return None


def emoji_for(pct, charging):
    if charging:
        return "\U0001F50C"  # 🔌
    # 🔋 full-ish, 🪫 low
    return "\U0001FAAB" if pct <= 20 else "\U0001F50B"


def bar_for(pct, width=10):
    filled = round(pct / 100 * width)
    return "█" * filled + "░" * (width - filled)  # █░


def main():
    ap = argparse.ArgumentParser(description="Razer battery status.")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("-p", "--percent", action="store_true",
                   help="just the number, e.g. 74")
    g.add_argument("-e", "--emoji", action="store_true",
                   help="battery emoji + percent, e.g. 🔋 74%%")
    g.add_argument("-b", "--bar", action="store_true",
                   help="unicode bar, e.g. 🔋 ███████░░░ 74%%")
    g.add_argument("-n", "--notify", action="store_true",
                   help="send a desktop notification (needs notify-send)")
    args = ap.parse_args()

    info = get_battery()
    if info is None:
        print("No Razer device with a battery found "
              "(is it awake and is openrazer-daemon running?)",
              file=sys.stderr)
        return 1
    name, pct, charging = info
    charge_txt = " (charging)" if charging else ""

    if args.percent:
        print(pct)
    elif args.emoji:
        print(f"{emoji_for(pct, charging)} {pct}%")
    elif args.bar:
        print(f"{emoji_for(pct, charging)} {bar_for(pct)} {pct}%")
    elif args.notify:
        import subprocess
        # Numerical-only passive popup via KDE's kdialog; auto-hides after
        # the given number of seconds.
        subprocess.run(["kdialog", "--title", "Razer Mouse Battery",
                        "--passivepopup", f"{pct}%{charge_txt}", "4"])
        print(f"{name}: {pct}%{charge_txt}")
    else:
        print(f"{name}: {pct}%{charge_txt}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
