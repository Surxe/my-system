#!/usr/bin/env bash
# dev-cc-tmux — open a tmux session in a "1x3+2" layout:
#
#   +-----------+-----------+-----------+   top 73%: three side-by-side
#   |  dev-cc   |  dev-cc   |  dev-cc   |   columns, each running dev-cc
#   +-----------+-----------+-----------+   (devsh + Claude Code)
#   | ethan shell |   devsh (dev shell) |   bottom 27%: left half = plain
#   +-------------+---------------------+   ethan shell (cwd=$HOME); right
#                                          half = dev shell (devsh, NOT cc)
#
# Meant to be launched inside a Konsole window:
#
#   konsole -e ~/.local/bin/dev-cc-tmux
#
# Deployed (COPIED, review-gated) into ethan's ~/.local/bin by install.sh's
# deploy_ethan_bin — it is NOT run from the dev-writable repo working tree, so
# dev-tree edits can't execute as ethan without a review-gated deploy.
#
# Konsole's own layout format can't carry a per-pane command (it only stores
# SessionRestoreId), so tmux does the splitting. Each top pane runs dev-cc,
# which ends in `exec bash`, so a pane stays alive as a dev shell after Claude
# exits. The bottom pane runs no command, so tmux starts ethan's default shell.
#
# Runs AS ethan; dev-cc hops to the dev user via devsh/sudo. The bottom pane
# stays as ethan (no user hop). tmux runs on ethan's default socket; the session
# name is PID-unique so repeated launches don't collide.
set -uo pipefail

# The deployed companion in ethan's own ~/.local/bin (a COPY, not the repo tree).
launcher="$HOME/.local/bin/dev-cc"
session="dev-cc-$$"

# Pane 0: top region, first Claude column (full width for now).
tmux new-session -d -s "$session" -c "$HOME" "$launcher"
top_left=$(tmux display-message -p -t "$session" '#{pane_id}')

# Split off the full-width bottom region (27% tall): a plain ethan shell at
# $HOME (no cmd → default login shell, no Claude). The new pane becomes active;
# capture it as the bottom-left, then halve it horizontally.
tmux split-window -v -l 27% -t "$top_left" -c "$HOME"
bot_left=$(tmux display-message -p -t "$session" '#{pane_id}')

# Right half of the bottom region: a dev shell via devsh, but NOT Claude. Runs
# through an interactive ethan shell (`bash -ic`) so `devsh` is defined; devsh
# hops to the dev user and drops to an interactive dev prompt (no `cc`).
tmux split-window -h -l 50% -t "$bot_left" "bash -ic devsh"

# Carve the top region (still top_left, now full width & 73% tall) into three
# equal Claude columns. First cut takes the right two-thirds, then halve it.
tmux split-window -h -l 66% -t "$top_left" -c "$HOME" "$launcher"
top_mid=$(tmux display-message -p -t "$session" '#{pane_id}')
tmux split-window -h -l 50% -t "$top_mid"  -c "$HOME" "$launcher"
tmux set-option -t "$session" mouse on          # click-to-focus + drag-resize
# Bridge mouse selections to the system clipboard. With `mouse on`, tmux
# captures drag-selections into its own buffer; without this they never reach
# the clipboard. tmux runs AS ethan (who owns the Wayland compositor), so pipe
# the selection straight to wl-copy — this crosses no user boundary and needs
# no OSC 52 support from Konsole. (Shift+drag still bypasses tmux for a native
# Konsole selection.)
tmux set-option -t "$session" set-clipboard on
tmux bind-key -T copy-mode    MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel wl-copy
tmux bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel wl-copy
tmux select-pane -t "$top_left"
exec tmux attach-session -t "$session"
