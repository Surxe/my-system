#!/usr/bin/env bash
# dev-cc — Konsole per-pane launcher: become the dev user and start Claude Code,
# then drop to an interactive dev shell when Claude exits.
#
# Used as the per-pane command for the tmux split scaffold (see dev-cc-tmux).
# Deployed (COPIED, review-gated) into ethan's ~/.local/bin by install.sh's
# deploy_ethan_bin, and invoked from there — never from the dev-writable repo
# working tree, so a dev-tree edit can't run as ethan without a review gate.
#
# Runs AS ethan. `devsh` (see .bashrc.d/10-devsh.sh) hops to the dev user via
# sudo; `cc` is the Claude alias in dev's ~/.bashrc. We go through an interactive
# ethan shell (`bash -ic`) so `devsh` is defined, and `devsh cc` in turn runs
# `cc` inside an interactive dev shell so the alias resolves.
#
# Depends on: passwordless `sudo -u dev` for ethan, and `claude` on dev's PATH.
exec bash -ic 'devsh cc'
