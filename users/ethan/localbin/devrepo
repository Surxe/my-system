#!/usr/bin/env bash
# devrepo — create, clone, or fork a repo under /srv/dev/repos, then drop into a
# dev shell inside it. Also accepts pending Surxe-dev collaborator invitations.
#
# Runs AS ethan. Deployed (COPIED, review-gated) into ethan's ~/.local/bin by
# install.sh's deploy_ethan_bin; never run from the dev-writable working tree.
#
# Depends on the shell helpers devsh / devperms / devsafe_ethan / devsafe_dev,
# sourced from ethan's DEPLOYED ~/.bashrc.d (not the repo tree), so the privilege
# boundary matches the rest of ethan's tooling. See development/shell-helpers.md.
#
# Formerly a shell function in .bashrc.d/40-devrepo.sh (with devaccept); that file
# is retired. A stale deployed copy shadows this bin -- remove it by hand:
#   rm ~/.bashrc.d/40-devrepo.sh && unset -f devrepo devaccept
set -uo pipefail

REPOS=/srv/dev/repos

usage() {
    cat <<'EOF'
usage: devrepo <mode> [args]

modes:
  new    <reponame> [--private|--public]
             Create Surxe/<reponame> on GitHub (default: public), init locally,
             push an empty initial commit, then perms + safe-dirs + accept + devsh.
  clone  <profile>/<reponame>
             Clone an existing GitHub repo (HTTPS) into /srv/dev/repos/<reponame>.
             Accepts the Surxe-dev invite only when <profile> is Surxe.
  fork   <profile>/<reponame> [<newname>]
             Fork into Surxe (as <newname> if given), clone it, add `upstream`.
  accept [<reponame>]
             As dev: accept all pending Surxe-dev collaborator invitations. With
             <reponame>, wait (up to 20s) until that repo's invite shows up.

options:
  -h, --help   show this help (also: devrepo help, devrepo <mode> --help)

examples:
  devrepo new my-tool --private
  devrepo clone FabianFG/CUE4Parse
  devrepo fork cheahjs/palworld-save-tools pal-tools
  devrepo accept my-tool
EOF
}

die_usage() { usage >&2; exit 1; }

# --- accept pending Surxe-dev collaborator invitations (runs AS dev) ---
accept() {
    sudo -u dev -H bash -c '
        set -euo pipefail
        export GIT_TERMINAL_PROMPT=0
        tok=$(printf "protocol=https\nhost=github.com\n\n" \
              | git credential fill 2>/dev/null | sed -n "s/^password=//p")
        [ -n "$tok" ] || { echo "devrepo accept: no dev github token in credential store" >&2; exit 1; }

        want="$1"
        start=$(date +%s)
        deadline=$(( start + 20 ))   # cap the wait at 20s

        while :; do
            invites=$(GH_TOKEN="$tok" gh api /user/repository_invitations \
                        --jq ".[] | \"\(.id)\t\(.repository.name)\"" 2>/dev/null || true)

            # accept everything visible right now
            printf "%s\n" "$invites" | while IFS=$'"'"'\t'"'"' read -r id name; do
                [ -n "$id" ] || continue
                GH_TOKEN="$tok" gh api -X PATCH "/user/repository_invitations/$id" >/dev/null \
                    && echo "devrepo accept: accepted invitation $id ($name)"
            done

            # done if not waiting for a specific repo, or it just showed up
            if [ -z "$want" ] || printf "%s\n" "$invites" | grep -qP "\t${want}$"; then
                [ -n "$want" ] && echo "devrepo accept: $want invite seen after $(( $(date +%s) - start ))s"
                break
            fi
            [ "$(date +%s)" -ge "$deadline" ] && {
                echo "devrepo accept: timed out after $(( $(date +%s) - start ))s waiting for $want" >&2
                exit 1
            }
            sleep 1
        done
    ' devrepo-accept "${1:-}"
}

mode="${1:-}"
shift 2>/dev/null || true

case "$mode" in
    -h|--help|help) usage; exit 0 ;;
    new|clone|fork|accept) ;;
    *) die_usage ;;
esac
for a in "$@"; do
    case "$a" in -h|--help) usage; exit 0 ;; esac
done

# Pull in the deployed shell helpers (after --help, so help
# works anywhere; functions only, no side effects at source).
for f in "$HOME"/.bashrc.d/{10-devsh,20-devperms,30-devsafe}.sh; do
    # shellcheck disable=SC1090
    if [ -r "$f" ]; then . "$f"; else echo "devrepo: missing helper $f (run install.sh)" >&2; exit 1; fi
done

upstream=""
case "$mode" in
    new)
        reponame="${1:-}"
        dest="$REPOS/$reponame"
        owner="Surxe"   # devscaffold always creates under Surxe
        if [ -z "$reponame" ] || [[ "$reponame" == */* ]]; then die_usage; fi
        case "${2:-}" in ""|--private|--public) ;; *) die_usage ;; esac
        [ -e "$dest" ] && { echo "already exists: $dest" >&2; exit 1; }
        url="$(sudo -u ethan -H /usr/local/sbin/devscaffold "$reponame" "${2:-}")" || exit 1
        git init -b main "$dest"                                  || exit 1
        git -C "$dest" remote add origin "$url"                   || exit 1
        # seed the default branch on both sides and connect them: an empty
        # initial commit gives the remote a `main` to receive, and `push -u`
        # sets local main to track origin/main. (ethan owns the repo, so the
        # admin bypass on the protection ruleset lets this direct push land.)
        git -C "$dest" commit --allow-empty -m "Initial commit"   || exit 1
        GIT_TERMINAL_PROMPT=0 git -C "$dest" push -u origin main  || exit 1
        ;;
    clone)
        slug="${1%.git}"
        reponame="${slug##*/}"
        owner="${slug%%/*}"
        dest="$REPOS/$reponame"
        url="https://github.com/${slug}.git"
        if [ -z "$slug" ] || [ "$slug" = "$reponame" ]; then die_usage; fi
        [ -e "$dest" ] && { echo "already exists: $dest" >&2; exit 1; }
        git clone "$url" "$dest" || exit 1
        ;;
    fork)
        # Like `new` (Surxe-owned remote, Surxe-dev collaborator, merge policy,
        # ruleset -- all via devscaffold), but seeded from an existing repo.
        slug="${1%.git}"
        reponame="${2:-${slug##*/}}"
        owner="Surxe"   # the fork always lands under Surxe
        dest="$REPOS/$reponame"
        if [ -z "$slug" ] || [ "$slug" = "${slug##*/}" ] || [[ "$reponame" == */* ]]; then die_usage; fi
        [ -e "$dest" ] && { echo "already exists: $dest" >&2; exit 1; }
        url="$(sudo -u ethan -H /usr/local/sbin/devscaffold --fork "$slug" "$reponame")" || exit 1
        git clone "$url" "$dest"                                            || exit 1
        git -C "$dest" remote add upstream "https://github.com/${slug}.git" || exit 1
        upstream="$slug"
        ;;
    accept)
        accept "${1:-}"; exit $?
        ;;
    *)
        die_usage
        ;;
esac

# shared tail: perms + both safe-dirs + accept invite + jump in as dev.
# Only repos under Ethan's own Surxe account invite Surxe-dev as a
# collaborator, so only those have an invite to accept -- skip the accept
# (and its 20s poll) when cloning a repo owned by anyone else.
devperms "$dest"      || exit 1
devsafe_ethan "$dest" || exit 1
devsafe_dev "$dest"   || exit 1
if [ "$owner" = "Surxe" ]; then
    accept "$reponame" || echo "warning: could not auto-accept invitations -- run: devrepo accept $reponame" >&2
fi
[ -n "$upstream" ] && echo "devrepo: origin = Surxe/$reponame, upstream = $upstream"
cd "$dest" || exit 1
devsh
