#!/usr/bin/env bash
# wrf-orchestrator — ethan entry point for the WRFrontiersDB patch-day pipeline.
#
# Runs AS ethan only long enough to read the ethan-owned secrets, then hops to
# `dev` to run the pipeline. Two reasons the work must be dev, not ethan:
#   1. The orchestrator + sub-repo code is dev-writable; running it as ethan
#      would execute dev-tree code with ethan's privileges.
#   2. The mapper step needs dev's render/video groups (granted for exactly this,
#      see users-and-permissions/groups.md). `sudo -u dev` does a fresh
#      initgroups, so the dev run picks those groups up.
#
# Secret model (same intent as the steam-price-tracker smtp route): the real
# secrets live ONLY in ~/.config/wrf-orchestrator/secrets.env (chmod 600,
# ethan-owned, hand-maintained) — never in the repo, never anywhere `dev` can
# read at rest. This launcher sources them into ethan's shell and passes exactly
# the three values across the sudo env_reset via --preserve-env, so `dev` sees
# them only transiently in the running process. They are never placed on a
# command line (no `ps` exposure). If they fail to arrive, the pipeline's
# preflight fails fast naming the missing secret — a safe failure, never a leak.
#
# This is the review-gated COPY in ethan's ~/.local/bin (deployed by
# my-system/users/install.sh — ethan-bin.sh copies every localbin file). Args
# pass through to run.py, e.g.
#   wrf-orchestrator --game-version 2026-08-22
#   wrf-orchestrator --should-parse true --should-build-site true --game-version 2026-08-22
set -uo pipefail

SECRETS="$HOME/.config/wrf-orchestrator/secrets.env"
REPO="/srv/dev/repos/WRFrontiersDB-Orchestrator"

if [ ! -r "$SECRETS" ]; then
    echo "wrf-orchestrator: missing secrets file: $SECRETS" >&2
    echo "  Create it from $REPO/secrets.env.example (chmod 600); see the repo README." >&2
    exit 1
fi

# Load secrets into THIS (ethan) shell only, exported so --preserve-env can carry
# them across the sudo boundary.
set -a; . "$SECRETS"; set +a

# Hop to dev (fresh initgroups -> render/video for the mapper), preserving only
# the three secrets. stdin/stdout stay this terminal's TTY so the pipeline's
# interactive manifest-date prompt still works. The inner `_` is $0 so launcher
# args land in "$@" for run.py.
sudo -u dev --preserve-env=STEAM_USERNAME,STEAM_PASSWORD,GH_DATA_REPO_PAT -H bash -c '
    cd /srv/dev/repos/WRFrontiersDB-Orchestrator || exit 1
    exec .venv/bin/python src/run.py "$@"
' _ "$@"
status=$?

if [ -t 0 ]; then
    echo
    read -n1 -r -p "Done (exit $status). Press any key to close..."
    echo
fi
exit "$status"
