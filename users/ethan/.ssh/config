
# todo cross-box sync hub. Purpose-named ('todo-hub') so the hub can be moved to
# another host without touching the todo tool's config — only HostName changes.
# 'home-server' is a convenience alias to the same box.
Host todo-hub home-server
    HostName 192.168.0.239
    User dev
    IdentityFile ~/.ssh/id_todo
    IdentitiesOnly yes
    ConnectTimeout 8
