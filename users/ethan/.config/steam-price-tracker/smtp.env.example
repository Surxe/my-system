# steam-price-tracker SMTP credentials (Gmail App Password) — TEMPLATE.
#
# This .example is the tracked template — NEVER put the real password here.
# The live file is ~/.config/steam-price-tracker/smtp.env (chmod 600, Ethan-owned,
# gitignored via *.env). install.sh creates it interactively if it is missing;
# the repo never stores the secret.
#
# Gmail requires a 16-char App Password (2-Step Verification must be on for the
# sending account) — not your normal account password. Presence of BOTH vars is
# the on-switch for email; absent, the tracker just fetches prices silently.
STEAM_TRACKER_SMTP_USER=your.sender@gmail.com
STEAM_TRACKER_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: override the recipient (defaults to config.EMAIL_TO = eethansur@gmail.com).
#STEAM_TRACKER_EMAIL_TO=eethansur@gmail.com
