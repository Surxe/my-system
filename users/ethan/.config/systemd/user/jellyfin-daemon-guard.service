[Unit]
Description=Stop the Docker daemon when the Jellyfin container dies (on-demand teardown)
Documentation=https://github.com/Surxe/my-system
# No [Install]/WantedBy: this must NOT start at boot (Docker is disabled then).
# The "Jellyfin Server" launcher starts it explicitly each session, right after it
# brings the jellyfin container up. It watches for the container to die, stops the
# daemon, and exits.

[Service]
Type=simple
Restart=no
# ethan is in the docker group, so `docker events` needs no sudo. `event=die` fires
# whether Jellyfin's Dashboard -> Shut Down exits the server process, or the container
# is stopped manually (docker stop / compose down) -- one filter covers both routes.
# On the first die we stop the daemon (NOPASSWD, see /etc/sudoers.d/docker-daemon);
# the daemon going down closes the events stream, so the unit exits cleanly.
ExecStart=/bin/bash -c 'docker events --filter container=jellyfin --filter event=die --format "{{.Actor.ID}}" | { read -r _; sudo /usr/bin/systemctl stop docker.service docker.socket; }'
