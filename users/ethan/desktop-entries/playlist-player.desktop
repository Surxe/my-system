[Desktop Entry]
# source: playlist-player  # hand-maintained (konsole flags; do not regenerate via add-shortcut)
# --desktopfile gives the Konsole window this entry's identity, so the taskbar shows this
# icon rather than Konsole's; --separate keeps it a process of its own so that holds.
Type=Application
Name=Playlist Player
Comment=Start the player, the lyric overlay and the page; closing the window stops them
Exec=konsole --separate --desktopfile playlist-player -p tabtitle=playlist-player -e /home/ethan/.local/bin/playlist-player.run.sh
Icon=/home/ethan/.local/share/playlist-player/playlist_player/server/static/icon.svg
Terminal=false
Categories=AudioVideo;Audio;Player;
StartupWMClass=playlist-player
