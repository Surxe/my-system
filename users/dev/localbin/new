#!/usr/bin/env bash
# new — start a fresh Claude Code session in this terminal WITHOUT inheriting the
# current session's /rename name.
#
# Background (todo t-0053): `/clear` starts a new session but, by design, carries
# forward a name set with --name or /rename (only an AI-generated title is
# dropped). That produces duplicate-named entries in /resume. The only way to get
# a genuinely fresh identity is a new `claude` process. `new` does that in place.
#
# Usage: run it from inside Claude via the `!` prompt prefix -> `!new`.
#
# Mechanism: the `cc` launcher (users/dev/.bashrc.d/10-claude.sh) runs Claude in a
# relaunch loop and exports CLAUDE_NEW_SENTINEL. Writing that file tells the loop
# to relaunch a brand-new session (new id + fresh AI title) instead of returning
# to the shell. This script only QUEUES the restart; a child process can't exit
# its parent Claude, so finish by exiting Claude yourself (Ctrl+D or /exit).
set -euo pipefail

if [ -z "${CLAUDE_NEW_SENTINEL:-}" ]; then
    echo "new: no restart sentinel in the environment (CLAUDE_NEW_SENTINEL unset)." >&2
    echo "     This session wasn't started by the 'cc' launcher, so it can't be" >&2
    echo "     relaunched in place. Start Claude with 'cc' to use 'new'." >&2
    exit 1
fi

: > "$CLAUDE_NEW_SENTINEL"
echo "new: fresh session queued. Press Ctrl+D (or type /exit) to start it."
