# This repo is documentation only — never commit secrets.
# Guard against accidental secret/key files landing here.
*.key
*.pem
*.env
.env
*.secret
secrets/
credentials*

# Encrypted-note payloads never belong in the repo. The pointer .md is tracked;
# any actual (encrypted) content is ignored.
private/encrypted-notes/
*.age
*.gpg

# devscaffold PAT — the *.example is tracked; the real token file never is.
**/devscaffold/token
*.token

# Regenerable derived state: the repo-description SHA->description cache
# (generate-repo-descriptions.sh). Repopulated on any run; never committed.
users/dev/.cache/
